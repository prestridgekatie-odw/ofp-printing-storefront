<main class="quote-page" data-controller="quote-form">
  <header class="quote-header">
    <%= link_to root_path, class: "quote-brand", aria: { label: "OFP Printing home" } do %>
      <%= image_tag "ofp/ofp-logo-transparent.png", alt: "OFP Printing" %>
    <% end %>
    <%= link_to "Back to home", root_path, class: "quote-home-link" %>
  </header>
  <section class="quote-shell" aria-labelledby="quote-title">
    <div class="quote-intro-block">
      <p class="quote-eyebrow">Get a quote</p>
      <h1 id="quote-title">Let&apos;s make it happen.</h1>
      <p class="quote-intro">A few details help us understand your project and get back to you with the right next steps.</p>
    </div>
    <%= render "form" %>
  </section>
</main>
