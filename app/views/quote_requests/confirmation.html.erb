<main class="quote-page quote-confirmation">
  <header class="quote-header">
    <%= link_to @return_to_home_url, class: "quote-brand", aria: { label: "OFP Printing home" } do %>
      <%= image_tag "ofp/ofp-logo-transparent.png", alt: "OFP Printing" %>
    <% end %>
    <%= link_to "Back to home", @return_to_home_url, class: "quote-home-link" %>
  </header>
  <section class="confirmation-shell" aria-labelledby="confirmation-title">
    <p class="quote-eyebrow">Request received</p>
    <h1 id="confirmation-title">We&apos;ve got your request.</h1>
    <p class="confirmation-reference">Reference <strong><%= @quote_request.public_reference %></strong></p>
    <p class="quote-intro">OFP will review your request and contact you with next steps.</p>
    <% if [@quote_request.notification_status, @quote_request.shopify_draft_order_status].include?("failed") %>
      <p class="form-errors" role="alert">Your request is saved, but an internal follow-up could not be completed. Please contact info@ofpprinting.com and include your reference.</p>
    <% end %>
    <div class="confirmation-actions">
      <%= link_to "Return to home", @return_to_home_url, class: "quote-button quote-button-secondary" %>
      <%= link_to "Start another quote", @start_another_quote_url, class: "quote-button quote-button-primary" %>
    </div>
  </section>
</main>
