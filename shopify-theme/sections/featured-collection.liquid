<section class="featured section-pad">
  <div class="section-heading">
    <div><p class="eyebrow">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.heading | escape }}</h2></div>
    {% if section.settings.collection != blank %}<a class="text-link" href="{{ section.settings.collection.url }}">View collection <span aria-hidden="true">&rarr;</span></a>{% endif %}
  </div>
  {% if section.settings.collection != blank and section.settings.collection.products_count > 0 %}
    <div class="product-grid">
      {% for product in section.settings.collection.products limit: section.settings.products_to_show %}
        {% render 'product-card', product: product %}
      {% endfor %}
    </div>
  {% else %}
    <div class="empty-collection"><p>{{ section.settings.empty_message | escape }}</p><a class="button button-dark" href="mailto:{{ settings.email | escape }}">Request a custom quote</a></div>
  {% endif %}
</section>

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Explore the shop" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Made for your next big idea" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "products_to_show", "min": 2, "max": 8, "step": 1, "label": "Products to show", "default": 4 },
    { "type": "text", "id": "empty_message", "label": "Empty collection message", "default": "Have a custom project in mind? Tell us what you need and we will help make it happen." }
  ],
  "presets": [{ "name": "Featured collection" }]
}
{% endschema %}