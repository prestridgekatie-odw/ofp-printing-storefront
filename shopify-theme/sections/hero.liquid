<section class="hero">
  {% if section.settings.image != blank %}
    {{ section.settings.image | image_url: width: 2400 | image_tag: class: 'hero-image', widths: '900, 1400, 1800, 2400', sizes: '100vw', fetchpriority: 'high', alt: section.settings.image.alt }}
  {% else %}
    <img class="hero-image" src="{{ 'hero-desktop.webp' | asset_url }}" alt="Custom printing and apparel" fetchpriority="high" width="1920" height="1080">
  {% endif %}
  <div class="hero-shade"></div>
  <div class="hero-content page-width">
    {% if section.settings.eyebrow != blank %}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
    <h1>{{ section.settings.heading | escape }}</h1>
    <p class="hero-copy">{{ section.settings.copy | escape }}</p>
    <div class="hero-actions">
      {% if section.settings.button_label != blank %}<a class="button button-bright" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label | escape }} <span aria-hidden="true">&rarr;</span></a>{% endif %}
      {% if section.settings.secondary_label != blank %}<a class="button button-outline" href="{{ section.settings.secondary_link | default: 'mailto:' | append: settings.email }}">{{ section.settings.secondary_label | escape }} <span aria-hidden="true">&rarr;</span></a>{% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "OFP Printing & Apparel" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "We bring your vision to life" },
    { "type": "textarea", "id": "copy", "label": "Text", "default": "High-quality custom printing for sports apparel, promotional products, and more." },
    { "type": "text", "id": "button_label", "label": "Primary button", "default": "Shop products" },
    { "type": "url", "id": "button_link", "label": "Primary link" },
    { "type": "text", "id": "secondary_label", "label": "Secondary button", "default": "Request a quote" },
    { "type": "url", "id": "secondary_link", "label": "Secondary link" }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}